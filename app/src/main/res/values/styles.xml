<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_bg</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:statusBarColor">@color/window_bg</item>
        <item name="android:navigationBarColor">@color/window_bg</item>
        <item name="android:alertDialogTheme">@style/FarmDialog</item>
    </style>

    <style name="FarmDialog" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_surface</item>
        <item name="android:windowMinWidthMajor">65%</item>
        <item name="android:windowMinWidthMinor">90%</item>
        <item name="android:backgroundDimAmount">0.48</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorBackground">@color/dialog_surface</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_dim</item>
        <item name="android:textAppearanceLarge">@style/DialogHeadline</item>
        <item name="android:textAppearanceMedium">@style/DialogBody</item>
        <item name="android:textAppearanceListItemSmall">@style/DialogBody</item>
        <item name="android:buttonBarButtonStyle">@style/DialogAction</item>
    </style>

    <style name="DialogHeadline" parent="android:TextAppearance.Material.Large">
        <item name="android:textSize">24sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="DialogBody" parent="android:TextAppearance.Material.Body1">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="DialogAction" parent="android:Widget.Material.Button.Borderless">
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">14sp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textColor">@color/accent</item>
        <item name="android:background">@drawable/dialog_action</item>
    </style>

    <style name="FarmControl" parent="android:Widget.Material.Button">
        <item name="android:background">@drawable/control_quiet</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">14sp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:paddingHorizontal">8dp</item>
        <item name="android:paddingVertical">8dp</item>
    </style>

    <style name="FarmControl.Primary">
        <item name="android:background">@drawable/control_primary</item>
        <item name="android:textColor">@color/window_bg</item>
    </style>

    <style name="FarmControl.Level">
        <item name="android:textColor">@color/level_card_text</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:minHeight">66dp</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:paddingVertical">12dp</item>
    </style>
</resources>
